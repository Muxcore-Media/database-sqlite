[Unit]
Description=MuxCore Module - database-sqlite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=muxcore
Group=muxcore
ExecStart=/usr/local/bin/database-sqlite \
  --muxcore-mesh-addr localhost:9090 \
  --muxcore-module-id database-sqlite
Environment=DATABASE_GRPC_ADDR=127.0.0.1:9700
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

; Security hardening
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/database-sqlite

[Install]
WantedBy=multi-user.target
